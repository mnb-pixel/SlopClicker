<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>

	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Token Furnace</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Beantwortet die Export-Compliance-Frage aus App Store Connect fest mit "nein" statt
	     bei jedem Upload erneut manuell zu fragen: die App nutzt keine eigene Verschlüsselung,
	     nur Standard-HTTPS über System-Frameworks (WKWebView, StoreKit) - das fällt unter die
	     Ausnahme für öffentlich verfügbare Standardverschlüsselung (Category 5 Part 2 EAR). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- TODO vor Release: durch die echte AdMob-App-ID aus der AdMob-Konsole ersetzen (siehe
	     ios-app-konzept.md §6). Aktuell Googles offizielle Test-App-ID - ohne eine gültige ID
	     hier crasht die App beim Start mit SIGABRT (GADApplicationVerifyPublisherInitializedCorrectly),
	     sobald das Mobile-Ads-SDK gelinkt ist, siehe nativeAdBridge.js. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-6020764817262332~4822974421</string>
	<!-- Googles eigene SKAdNetwork-ID für AdMob (Ad-Attribution ohne IDFA) - reicht für
	     direktes AdMob ohne Mediation. Bei späterer Mediation um die jeweiligen Netzwerk-IDs
	     ergänzen (Liste: https://developers.google.com/admob/ios/mediation). -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
	<!-- Pflicht-String für den ATT-Systemprompt (AppTrackingTransparency) - siehe
	     requestTrackingIfNeeded in adConsent.js, gezeigt nach einem eigenen Erklärbildschirm
	     und erst nach der ersten Spielinteraktion, nicht beim Kaltstart. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>This identifier is used to show you more relevant ads and to support the free version of the app.</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
